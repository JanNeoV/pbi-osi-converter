+
+import pytest
+from ossie_dbt import MSIToOssieConverter, OssieToMSIConverter
+from metricflow_semantic_interfaces.test_utils import semantic_model_with_guaranteed_meta
+from metricflow_semantic_interfaces.type_enums import EntityType, AggregationType
+from tests.helpers import _entity, _measure, _manifest
+
+
+@pytest.mark.parametrize("key_type", [EntityType.PRIMARY, EntityType.UNIQUE])
+def test_alias_keys_reference_fields_without_promoting_measure_aliases(key_type):
+    dimension = semantic_model_with_guaranteed_meta(
+        name="dimension", entities=[_entity("customer", key_type, "customer_id")],
+        measures=[_measure("customer_count", AggregationType.COUNT_DISTINCT, "customer_id")],
+    )
+    fact = semantic_model_with_guaranteed_meta(
+        name="fact", entities=[_entity("row", EntityType.PRIMARY, "row_id"),
+                               _entity("customer", EntityType.FOREIGN, "customer_id")],
+    )
+    document = MSIToOssieConverter().convert(_manifest(semantic_models=[dimension, fact])).output
+    fields = {dataset.name: {field.name for field in dataset.fields} for dataset in document.datasets}
+    for dataset in document.datasets:
+        for key in ([dataset.primary_key] if dataset.primary_key else []) + (dataset.unique_keys or []):
+            assert set(key) <= fields[dataset.name]
+    for relationship in document.relationships:
+        assert set(relationship.from_columns) <= fields[relationship.from_dataset]
+        assert set(relationship.to_columns) <= fields[relationship.to]
+    returned = OssieToMSIConverter().convert(document).output
+    assert [(e.name, e.type, e.expr) for e in returned.semantic_models[0].entities] == [
+        ("customer", key_type, "customer_id")
+    ]
+    assert [(e.name, e.type, e.expr) for e in returned.semantic_models[1].entities] == [
+        ("row", EntityType.PRIMARY, "row_id"), ("customer", EntityType.FOREIGN, "customer_id")
+    ]
+
+
+def test_reverse_does_not_promote_a_measure_with_the_same_physical_expression():
+    model = semantic_model_with_guaranteed_meta(
+        name="orders", entities=[_entity("order", EntityType.PRIMARY, "order_id")],
+        measures=[_measure("order_count", AggregationType.COUNT_DISTINCT, "order_id")],
+    )
+    document = MSIToOssieConverter().convert(_manifest(semantic_models=[model])).output
+    returned = OssieToMSIConverter().convert(document).output
+    assert [e.name for e in returned.semantic_models[0].entities] == ["order"]
