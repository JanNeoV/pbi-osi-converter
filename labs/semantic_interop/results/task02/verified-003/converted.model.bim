{
  "compatibilityLevel": 1702,
  "model": {
    "culture": "en-US",
    "expressions": [
      {
        "expression": [
          "let",
          "    Source = AzureStorage.DataLake(\"https://onelake.dfs.fabric.microsoft.com/00000000-0000-0000-0000-000000000000/00000000-0000-0000-0000-000000000000\")",
          "in",
          "    Source"
        ],
        "kind": "m",
        "name": "DatabaseQuery"
      }
    ],
    "tables": [
      {
        "columns": [
          {
            "name": "order",
            "sourceColumn": "order_id"
          },
          {
            "name": "order_date",
            "sourceColumn": "order_date"
          },
          {
            "name": "status",
            "sourceColumn": "status"
          },
          {
            "name": "order_count_measure",
            "sourceColumn": "order_id"
          },
          {
            "name": "customers_measure",
            "sourceColumn": "customer_id"
          }
        ],
        "measures": [
          {
            "annotations": [
              {
                "name": "OssieExpressionDialect",
                "value": "ANSI_SQL"
              },
              {
                "name": "OssieExpression",
                "value": "SUM(items.amount)"
              }
            ],
            "expression": "SUM('items'[revenue_measure])",
            "name": "revenue"
          },
          {
            "annotations": [
              {
                "name": "OssieExpressionDialect",
                "value": "ANSI_SQL"
              },
              {
                "name": "OssieExpression",
                "value": "COUNT(DISTINCT orders.order_id)"
              }
            ],
            "expression": "BLANK()",
            "name": "order_count"
          },
          {
            "annotations": [
              {
                "name": "OssieExpressionDialect",
                "value": "ANSI_SQL"
              },
              {
                "name": "OssieExpression",
                "value": "COUNT(DISTINCT orders.customer_id)"
              }
            ],
            "expression": "DISTINCTCOUNTNOBLANK('orders'[customers_measure])",
            "name": "purchasing_customers"
          },
          {
            "annotations": [
              {
                "name": "OssieExpressionDialect",
                "value": "ANSI_SQL"
              },
              {
                "name": "OssieExpression",
                "value": "SUM(CASE WHEN item__status = 'completed' THEN items.amount END)"
              }
            ],
            "expression": "BLANK()",
            "name": "completed_revenue"
          },
          {
            "annotations": [
              {
                "name": "OssieExpressionDialect",
                "value": "ANSI_SQL"
              },
              {
                "name": "OssieExpression",
                "value": "(SUM(items.amount)) / (COUNT(DISTINCT orders.order_id))"
              }
            ],
            "expression": "BLANK()",
            "name": "average_order_value"
          },
          {
            "annotations": [
              {
                "name": "OssieExpressionDialect",
                "value": "ANSI_SQL"
              },
              {
                "name": "OssieExpression",
                "value": "(SUM(CASE WHEN item__status = 'completed' THEN items.amount END)) / (SUM(items.amount))"
              }
            ],
            "expression": "BLANK()",
            "name": "completed_revenue_share"
          }
        ],
        "name": "orders",
        "partitions": [
          {
            "mode": "directLake",
            "name": "orders",
            "source": {
              "entityName": "orders",
              "expressionSource": "DatabaseQuery",
              "schemaName": "main",
              "type": "entity"
            }
          }
        ]
      },
      {
        "columns": [
          {
            "name": "item",
            "sourceColumn": "item_id"
          },
          {
            "name": "order",
            "sourceColumn": "order_id"
          },
          {
            "name": "product",
            "sourceColumn": "product_id"
          },
          {
            "name": "order_date",
            "sourceColumn": "order_date"
          },
          {
            "name": "status",
            "sourceColumn": "status"
          },
          {
            "name": "revenue_measure",
            "sourceColumn": "amount"
          }
        ],
        "name": "items",
        "partitions": [
          {
            "mode": "directLake",
            "name": "items",
            "source": {
              "entityName": "items",
              "expressionSource": "DatabaseQuery",
              "schemaName": "main",
              "type": "entity"
            }
          }
        ]
      },
      {
        "columns": [
          {
            "name": "product",
            "sourceColumn": "product_id"
          },
          {
            "name": "category",
            "sourceColumn": "category"
          }
        ],
        "name": "products",
        "partitions": [
          {
            "mode": "directLake",
            "name": "products",
            "source": {
              "entityName": "products",
              "expressionSource": "DatabaseQuery",
              "schemaName": "main",
              "type": "entity"
            }
          }
        ]
      }
    ]
  },
  "name": "synthetic_shop"
}
