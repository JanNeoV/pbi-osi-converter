{
  "semantic_models": [
    {
      "name": "conversion_demo_databricks",
      "node_relation": {
        "alias": "session_date, s.sales_channel, s.is_eligible,\n       o.order_id, o.order_date, o.amount_eur, o.order_status\nFROM demo.semantic_interop.sessions AS s\nLEFT JOIN demo.semantic_interop.orders AS o\n  ON s.session_id = o.session_id\n AND o.order_date < DATE '2026-03-01'\nWHERE s.session_date >= DATE '2026-01-01'\n  AND s.session_date < DATE '2026-03-01'\n",
        "schema_name": "session_id, s",
        "database": "SELECT s",
        "relation_name": "SELECT s.session_id, s.session_date, s.sales_channel, s.is_eligible,\n       o.order_id, o.order_date, o.amount_eur, o.order_status\nFROM demo.semantic_interop.sessions AS s\nLEFT JOIN demo.semantic_interop.orders AS o\n  ON s.session_id = o.session_id\n AND o.order_date < DATE '2026-03-01'\nWHERE s.session_date >= DATE '2026-01-01'\n  AND s.session_date < DATE '2026-03-01'\n"
      },
      "entities": [],
      "measures": [],
      "dimensions": [
        {
          "name": "sales_channel",
          "description": "One channel per originating session",
          "type": "categorical",
          "is_partition": false
        },
        {
          "name": "session_month",
          "description": "Session cohort month, not transaction month",
          "type": "categorical",
          "is_partition": false,
          "expr": "CAST(DATE_TRUNC('MONTH', session_date) AS DATE)"
        }
      ]
    }
  ],
