{
  "compatibilityLevel": 1702,
  "model": {
    "culture": "en-US",
    "expressions": [
      {
        "expression": [
          "let",
          "    Source = AzureStorage.DataLake(\"https://onelake.dfs.fabric.microsoft.com/00000000-0000-0000-0000-000000000000/00000000-0000-0000-0000-000000000000\")",
          "in",
          "    Source"
        ],
        "kind": "m",
        "name": "DatabaseQuery"
      }
    ],
    "tables": [
      {
        "columns": [
          {
            "name": "session",
            "sourceColumn": "session_id"
          },
          {
            "name": "session_date",
            "sourceColumn": "session_date"
          },
          {
            "name": "sales_channel",
            "sourceColumn": "sales_channel"
          },
          {
            "name": "is_eligible",
            "sourceColumn": "is_eligible"
          },
          {
            "name": "session_count",
            "sourceColumn": "session_id"
          }
        ],
        "measures": [
          {
            "annotations": [
              {
                "name": "OssieExpressionDialect",
                "value": "ANSI_SQL"
              },
              {
                "name": "OssieExpression",
                "value": "COUNT(DISTINCT CASE WHEN session__is_eligible = true THEN sessions.session_id END)"
              }
            ],
            "expression": "BLANK()",
            "name": "eligible_sessions"
          },
          {
            "annotations": [
              {
                "name": "OssieExpressionDialect",
                "value": "ANSI_SQL"
              },
              {
                "name": "OssieExpression",
                "value": "COUNT(DISTINCT CASE WHEN session__is_eligible = true AND order__order_status = 'paid' THEN orders.session_id END)"
              }
            ],
            "expression": "BLANK()",
            "name": "converted_sessions_base"
          },
          {
            "annotations": [
              {
                "name": "OssieExpressionDialect",
                "value": "ANSI_SQL"
              },
              {
                "name": "OssieExpression",
                "value": "SUM(CASE WHEN session__is_eligible = true AND order__order_status = 'paid' THEN orders.amount_eur END)"
              }
            ],
            "expression": "BLANK()",
            "name": "paid_revenue_base"
          },
          {
            "annotations": [
              {
                "name": "OssieExpressionDialect",
                "value": "ANSI_SQL"
              },
              {
                "name": "OssieExpression",
                "value": "COUNT(DISTINCT CASE WHEN session__is_eligible = true AND order__order_status = 'paid' THEN orders.order_id END)"
              }
            ],
            "expression": "BLANK()",
            "name": "paid_order_count_base"
          },
          {
            "annotations": [
              {
                "name": "OssieExpressionDialect",
                "value": "ANSI_SQL"
              },
              {
                "name": "OssieExpression",
                "value": "(COALESCE(COUNT(DISTINCT CASE WHEN session__is_eligible = true AND order__order_status = 'paid' THEN orders.session_id END), 0) + 0 * COUNT(DISTINCT CASE WHEN session__is_eligible = true THEN sessions.session_id END)) / (COUNT(DISTINCT CASE WHEN session__is_eligible = true THEN sessions.session_id END))"
              }
            ],
            "expression": "BLANK()",
            "name": "conversion_rate"
          },
          {
            "annotations": [
              {
                "name": "OssieExpressionDialect",
                "value": "ANSI_SQL"
              },
              {
                "name": "OssieExpression",
                "value": "(SUM(CASE WHEN session__is_eligible = true AND order__order_status = 'paid' THEN orders.amount_eur END) + 0 * COUNT(DISTINCT CASE WHEN session__is_eligible = true THEN sessions.session_id END)) / (COALESCE(COUNT(DISTINCT CASE WHEN session__is_eligible = true AND order__order_status = 'paid' THEN orders.order_id END), 0) + 0 * COUNT(DISTINCT CASE WHEN session__is_eligible = true THEN sessions.session_id END))"
              }
            ],
            "expression": "BLANK()",
            "name": "average_paid_order_value"
          },
          {
            "annotations": [
              {
                "name": "OssieExpressionDialect",
                "value": "ANSI_SQL"
              },
              {
                "name": "OssieExpression",
                "value": "COALESCE(COUNT(DISTINCT CASE WHEN session__is_eligible = true AND order__order_status = 'paid' THEN orders.session_id END), 0) + 0 * COUNT(DISTINCT CASE WHEN session__is_eligible = true THEN sessions.session_id END)"
              }
            ],
            "expression": "BLANK()",
            "name": "converted_sessions"
          },
          {
            "annotations": [
              {
                "name": "OssieExpressionDialect",
                "value": "ANSI_SQL"
              },
              {
                "name": "OssieExpression",
                "value": "SUM(CASE WHEN session__is_eligible = true AND order__order_status = 'paid' THEN orders.amount_eur END) + 0 * COUNT(DISTINCT CASE WHEN session__is_eligible = true THEN sessions.session_id END)"
              }
            ],
            "expression": "BLANK()",
            "name": "paid_revenue"
          },
          {
            "annotations": [
              {
                "name": "OssieExpressionDialect",
                "value": "ANSI_SQL"
              },
              {
                "name": "OssieExpression",
                "value": "COALESCE(COUNT(DISTINCT CASE WHEN session__is_eligible = true AND order__order_status = 'paid' THEN orders.order_id END), 0) + 0 * COUNT(DISTINCT CASE WHEN session__is_eligible = true THEN sessions.session_id END)"
              }
            ],
            "expression": "BLANK()",
            "name": "paid_order_count"
          }
        ],
        "name": "sessions",
        "partitions": [
          {
            "mode": "directLake",
            "name": "sessions",
            "source": {
              "entityName": "sessions",
              "expressionSource": "DatabaseQuery",
              "schemaName": "main",
              "type": "entity"
            }
          }
        ]
      },
      {
        "columns": [
          {
            "name": "order",
            "sourceColumn": "order_id"
          },
          {
            "name": "session",
            "sourceColumn": "session_id"
          },
          {
            "name": "session_date",
            "sourceColumn": "session_date"
          },
          {
            "name": "order_status",
            "sourceColumn": "order_status"
          },
          {
            "name": "converted_session_count",
            "sourceColumn": "session_id"
          },
          {
            "name": "order_count",
            "sourceColumn": "order_id"
          },
          {
            "name": "revenue",
            "sourceColumn": "amount_eur"
          }
        ],
        "name": "orders",
        "partitions": [
          {
            "mode": "directLake",
            "name": "orders",
            "source": {
              "entityName": "orders",
              "expressionSource": "DatabaseQuery",
              "schemaName": "main",
              "type": "entity"
            }
          }
        ]
      }
    ]
  },
  "name": "conversion_demo"
}
