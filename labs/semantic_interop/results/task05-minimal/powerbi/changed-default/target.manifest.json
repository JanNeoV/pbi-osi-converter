  "metrics": [
    {
      "name": "Eligible Sessions",
      "type": "simple",
      "type_params": {
        "expr": "COALESCE(\n    CALCULATE(\n        DISTINCTCOUNT(Sessions[session_id]),\n        KEEPFILTERS(Sessions[is_eligible] = TRUE()),\n        KEEPFILTERS(Sessions[session_date] >= DATE(2026, 1, 1)),\n        KEEPFILTERS(Sessions[session_date] < DATE(2026, 3, 1))\n    ),\n    0\n)",
        "input_measures": [],
        "metric_aggregation_params": {
          "semantic_model": "Sessions",
          "agg": "sum"
        },
        "join_to_timespine": false,
        "is_private": false
      }
    },
    {
      "name": "Converted Sessions",
      "type": "simple",
      "type_params": {
        "expr": "COALESCE(\n    CALCULATE(\n        DISTINCTCOUNT(Orders[session_id]),\n        KEEPFILTERS(Sessions[is_eligible] = TRUE()),\n        KEEPFILTERS(Sessions[session_date] >= DATE(2026, 1, 1)),\n        KEEPFILTERS(Sessions[session_date] < DATE(2026, 3, 1)),\n        KEEPFILTERS(Orders[order_status] = \"paid\"),\n        KEEPFILTERS(Orders[order_date] < DATE(2026, 3, 1))\n    ),\n    0\n)",
        "input_measures": [],
        "metric_aggregation_params": {
          "semantic_model": "Sessions",
          "agg": "sum"
        },
        "join_to_timespine": false,
        "is_private": false
      }
    },
    {
      "name": "Conversion Rate",
      "type": "simple",
      "type_params": {
        "expr": "DIVIDE([Converted Sessions], [Eligible Sessions])",
        "input_measures": [],
        "metric_aggregation_params": {
          "semantic_model": "Sessions",
          "agg": "sum"
        },
        "join_to_timespine": false,
        "is_private": false
      }
    },
    {
      "name": "Paid Revenue",
      "type": "simple",
      "type_params": {
        "expr": "CALCULATE(\n    SUM(Orders[amount_eur]),\n    KEEPFILTERS(Sessions[is_eligible] = TRUE()),\n    KEEPFILTERS(Sessions[session_date] >= DATE(2026, 1, 1)),\n        KEEPFILTERS(Sessions[session_date] < DATE(2026, 3, 1)),\n    KEEPFILTERS(Orders[order_status] = \"paid\"),\n    KEEPFILTERS(Orders[order_date] < DATE(2026, 3, 1))\n)",
        "input_measures": [],
        "metric_aggregation_params": {
          "semantic_model": "Sessions",
          "agg": "sum"
        },
        "join_to_timespine": false,
        "is_private": false
      }
    },
    {
      "name": "Selected KPI",
      "type": "simple",
      "type_params": {
        "expr": "SWITCH(\n    SELECTEDVALUE('KPI Selector'[KPI], \"Paid Revenue\"),\n    \"Conversion Rate\", [Conversion Rate],\n    \"Paid Revenue\", [Paid Revenue],\n    BLANK()\n)",
        "input_measures": [],
        "metric_aggregation_params": {
          "semantic_model": "Sessions",
          "agg": "sum"
        },
        "join_to_timespine": false,
        "is_private": false
      }
    }
  ],
