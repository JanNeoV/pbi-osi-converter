        "terminal_marker": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256",
        "task_id",
        "terminal_marker"
      ],
      "type": "object"
    },
    "protected_input": {
      "additionalProperties": false,
