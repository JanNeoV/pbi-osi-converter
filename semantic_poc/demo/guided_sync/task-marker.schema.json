{
  "$defs": {
    "artifact": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "FILE",
            "TREE"
          ]
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "kind",
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "limitation": {
      "additionalProperties": false,
      "properties": {
        "blocking": {
          "type": "boolean"
        },
        "reason_code": {
          "minLength": 1,
          "type": "string"
        },
        "scope": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "blocking",
        "reason_code",
        "scope"
      ],
      "type": "object"
    },
    "path": {
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$",
      "type": "string"
    },
    "prerequisite": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
