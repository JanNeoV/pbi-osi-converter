model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-DE
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["MEASURES_","DIM_AGE_GROUP","DIM_COUNTRY","DIM_DISTANCE","DIM_DIVSION","DIM_EVENT","DIM_GENDER","FCT_RESULT","FCT_SPLIT"]

annotation PBI_ProTooling = ["DevMode"]

ref table MEASURES_
ref table DIM_AGE_GROUP
ref table DIM_COUNTRY
ref table DIM_DISTANCE
ref table DIM_DIVSION
ref table DIM_EVENT
ref table DIM_GENDER
ref table FCT_RESULT
ref table FCT_SPLIT

ref cultureInfo en-US

