	/// Identifier for athlete division or category.
	column division_id
		dataType: string
		lineageTag: 800888de-5e1e-4270-a96c-337716e8006f
		summarizeBy: none
		sourceColumn: division_id

		annotation SummarizationSetBy = Automatic

	/// Display label for the athlete division or category.
	column division
		dataType: string
		lineageTag: 87745816-c4a6-4e6b-8744-9b812d4115f1
		summarizeBy: none
		sourceColumn: division

		annotation SummarizationSetBy = Automatic

	/// True when the division represents professional athletes.
	column is_pro
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
